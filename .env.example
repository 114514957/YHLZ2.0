# YHLZ 2.0 环境配置文件

# API提供商选择 (deepseek 或 dashscope)
API_PROVIDER=dashscope

# 阿里云通义千问API配置（从系统环境变量DASHSCOPE_API_KEY读取）
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
DASHSCOPE_MODEL=qwen-turbo

# 模型配置
ASR_MODEL=Paraformer-small
TTS_MODEL=edge-tts
VAD_MODEL=silero_vad

# TTS引擎选择 (蓝图1.1): edge-tts / auto
TTS_ENGINE=edge-tts

# 情绪→音色映射 (蓝图1.4): EMOTION_ENABLED / EMOTION_CONFIDENCE_THRESHOLD
EMOTION_ENABLED=true
EMOTION_CONFIDENCE_THRESHOLD=0.5

# 回声过滤防自嗨 (蓝图1.5): 本机播放窗口内的输入丢弃
ECHO_FILTER_ENABLED=true

# 低延迟TTS (蓝图1.2): 首段最小播放时长ms, 首段就绪即开口
TTS_FIRST_CHUNK_MIN_MS=500

# 预留开关 (蓝图4.1, 后续阶段)
PROACTIVE_ENABLED=false
ACTIVITY_ENABLED=false

# 性能配置
ASR_DEVICE=cpu
TTS_DEVICE=cuda
TTS_PRECISION=fp16
USE_TORCH_COMPILE=true

# 上下文配置
MAX_CONTEXT_TOKENS=8000
SUMMARY_THRESHOLD=7000

# 音频配置
TTS_BUFFER_MS=10
SAMPLE_RATE=24000
