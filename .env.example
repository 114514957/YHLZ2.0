# YHLZ 环境变量示例
# 用法：复制为 .env（.env 已被 .gitignore 忽略，勿入库）

# --- LLM 兜底（可选；主线是本地 Gemma，不需要）---
# DEEPSEEK_API_KEY=your_key_here
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DASHSCOPE_API_KEY=your_key_here

# --- 本地模型目录（默认见 tools/yhlz_launcher.py）---
# YHLZ_MODELS_DIR=C:\Users\ACE_WAN——PROJECT\models

# --- HuggingFace（下载 gated 基座如 google/gemma-4-E4B-it 用）---
# HF_TOKEN=hf_your_token_here

# --- QQ OneBot access token（也可放 config/qqwatch.local.json）---
# YHLZ_QQ_TOKEN=

# --- daemon ---
# YHLZ_DAEMON_PORT=8321
# YHLZ_AUTONOMY_SECONDS=10800

# --- 上下文 / 语音 ---
# YHLZ_CTX_BUDGET=16000
